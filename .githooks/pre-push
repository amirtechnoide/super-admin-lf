#!/bin/sh
#
# Compile le projet avant de laisser partir un push.
#
# `next build` lance aussi le contrôle TypeScript, mais pas ESLint : un `any`
# de trop passera donc ce crochet. Pour l'ajouter, enchaîner `npm run lint`
# ci-dessous, une fois les erreurs existantes corrigées.
#
# Pour passer outre ponctuellement : git push --no-verify

ZERO="0000000000000000000000000000000000000000"

# Git envoie sur l'entrée standard une ligne par référence poussée. Un push qui
# ne fait que supprimer des branches distantes n'a rien à compiler.
lu=0
a_compiler=0
while read -r _ref_local sha_local _ref_distant _sha_distant; do
  lu=1
  if [ "$sha_local" != "$ZERO" ]; then
    a_compiler=1
  fi
done

if [ "$lu" = 1 ] && [ "$a_compiler" = 0 ]; then
  echo "pre-push : suppression de référence uniquement, build inutile."
  exit 0
fi

echo "pre-push : build de vérification en cours…"

if ! npm run build; then
  echo ""
  echo "pre-push : le build a échoué, le push est interrompu."
  echo "           Corrigez l'erreur ci-dessus, ou forcez avec :"
  echo "             git push --no-verify"
  exit 1
fi

echo "pre-push : build réussi, le push continue."
exit 0
