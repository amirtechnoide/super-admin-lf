# Backend relayé par Next (app/api/backend/[...path]/route.ts).
# Le backend répond 403 à toute requête portant un `Origin` autre que le sien :
# le relais retire cet en-tête, ce qui ramène l'appel à un échange serveur à
# serveur. Valeur = URL absolue du backend, sans slash final.
API_PROXY_TARGET=https://sogafric-backend.lf-company.com

# URL utilisée par le navigateur.
#   /api/backend                  -> passe par le relais (défaut, fonctionne partout)
#   https://votre-backend.exemple -> appel direct, à n'utiliser que le jour où
#                                    le CORS du backend accepte l'origine du
#                                    dashboard. Le relais devient alors inutile.
NEXT_PUBLIC_API_BASE_URL=/api/backend
